# Normalise line endings so a file edited on another machine does not show as
# entirely rewritten, and so the ASCII check is not confused by mixed endings.
* text=auto

# PowerShell and XAML are Windows-facing: keep CRLF in the working tree.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.xaml  text eol=crlf
*.ps1xml text eol=crlf

# Docs, CI and git's own config files stay LF.
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
LICENSE text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
